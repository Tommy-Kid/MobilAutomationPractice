pipeline {
    agent any

    parameters {
        choice(name: 'DEVICE', choices: ['pixel10ProFold', 'pixel9Pro'], description: 'Eszköz')
    }

    triggers {
            cron('H 2 * * 1-5')
        }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        timestamps()
    }

     environment {
            ANDROID_HOME = 'C:\\Users\\ladan\\AppData\\Local\\Android\\Sdk'
            ADB          = 'C:\\Users\\ladan\\AppData\\Local\\Android\\Sdk\\platform-tools\\adb.exe'
            EMULATOR     = 'C:\\Users\\ladan\\AppData\\Local\\Android\\Sdk\\emulator\\emulator.exe'
            MVN          = 'C:\\Program Files\\JetBrains\\IntelliJ IDEA 2026.2.3\\plugins\\maven-plugin\\lib\\maven3\\bin\\mvn.cmd'
            APK_URL      = 'https://github.com/webdriverio/native-demo-app/releases/download/v2.2.0/android.wdio.native.app.v2.2.0.apk'
            REPORT_ROOT  = 'C:\\JenkinsReports\\appium'
     }

    stages {
        stage('Checkout Code') {
            steps {
                 checkout scm
            }
        }

        stage('Device settings') {
            steps {
                script {
                    def devices = [
                        pixel9Pro     : [avd: 'Pixel_9_Pro',       port: '5554'],
                        pixel10ProFold: [avd: 'Pixel_10_Pro_Fold', port: '5556']
                    ]
                    env.AVD    = devices[params.DEVICE].avd
                    env.SERIAL = "emulator-${devices[params.DEVICE].port}"
                    env.PORT   = devices[params.DEVICE].port
                }
            }
        }

        stage('Download app') {
            steps {
                powershell '''
                    $dir = "appium\\src\\test\\resources\\app"
                    New-Item -ItemType Directory -Force -Path $dir | Out-Null
                    $apk = Join-Path $dir "android.wdio.native.app.v2.2.0.apk"
                    if (-not (Test-Path $apk)) {
                        Invoke-WebRequest -Uri $env:APK_URL -OutFile $apk
                    }
                '''
            }
        }

         stage('Compile') {
            steps {
                bat '"%MVN%" -B -f appium\\pom.xml -DskipTests clean compile'
            }
        }

        stage('Start emulator') {
            options { timeout(time: 8, unit: 'MINUTES') }
            steps {
                // Ez a valtozat futott le a #6-os buildben 1 perc alatt - szandekosan egyszeru
                powershell '''
                    Start-Process $env:EMULATOR -ArgumentList "-avd",$env:AVD,"-port",$env:PORT,"-no-audio","-no-boot-anim"
                    & $env:ADB -s $env:SERIAL wait-for-device
                    $deadline = (Get-Date).AddMinutes(5)
                    do {
                        Start-Sleep -Seconds 5
                        $booted = (& $env:ADB -s $env:SERIAL shell getprop sys.boot_completed 2>$null)
                        Write-Host "boot_completed=$booted"
                    } until ($booted -match "1" -or (Get-Date) -gt $deadline)
                    if ($booted -notmatch "1") { throw "Emulator did not boot in time" }
                    Start-Sleep -Seconds 15
                '''
            }
        }

        stage('Mobile tests') {
            steps {
                bat '"%MVN%" -B -f appium\\pom.xml verify -Ddevice=%DEVICE% -Dmaven.test.failure.ignore=true'
            }
        }
    }

    post {
        always {
            script {
                def r = junit allowEmptyResults: true, testResults: 'appium/target/failsafe-reports/*.xml, appium/target/surefire-reports/*.xml'
                env.T_TOTAL = "${r.totalCount}"; env.T_PASS = "${r.passCount}"
                env.T_FAIL  = "${r.failCount}";  env.T_SKIP = "${r.skipCount}"
            }


    archiveArtifacts allowEmptyArchive: true,
        artifacts: 'appium/target/reports/**, appium/target/site/serenity/**, appium/target/screenshots/**, appium/target/appium-server.log'

        powershell '''
            $dest = Join-Path $env:REPORT_ROOT $env:BUILD_NUMBER
            New-Item -ItemType Directory -Force -Path $dest | Out-Null
            foreach ($p in "appium\\target\\reports", "appium\\target\\site\\serenity", "appium\\target\\screenshots", "appium\\target\\failsafe-reports") {
                if (Test-Path $p) { Copy-Item $p -Destination $dest -Recurse -Force }
            }
            & $env:ADB -s $env:SERIAL emu kill 2>$null
            exit 0
        '''

        emailext(
            subject: "${currentBuild.currentResult == 'SUCCESS' ? '✅' : '❌'} Appium tests #${env.BUILD_NUMBER}: ${currentBuild.currentResult}",
            to: '$DEFAULT_RECIPIENTS',
            mimeType: 'text/html',
            body: """
                <h2>Appium tests – build #${env.BUILD_NUMBER} (${params.DEVICE})</h2>
                <p><b>Result:</b> ${currentBuild.currentResult}</p>
                <p>Total: ${env.T_TOTAL} | Passed: ${env.T_PASS} | Failed: ${env.T_FAIL} | Skipped: ${env.T_SKIP}</p>
                <p>Report: <a href="${env.BUILD_URL}artifact/appium/target/reports/ExtentReport.html">Extent report</a></p>
                <p>Local copy: <code>${env.REPORT_ROOT}\\${env.BUILD_NUMBER}</code></p>
                <p>Console: <a href="${env.BUILD_URL}console">${env.BUILD_URL}console</a></p>
            """,
            attachLog: currentBuild.currentResult != 'SUCCESS'
        )
    }
    }
}